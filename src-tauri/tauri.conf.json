{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "海克斯大乱斗小助手",
  "version": "0.1.0",
  "identifier": "com.aramcompanion.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "海克斯大乱斗小助手",
        "create": false,
        "width": 800,
        "height": 580,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "ocr-overlay",
        "title": "海克斯大乱斗小助手 · 海克斯建议",
        "create": false,
        "url": "index.html?window=ocr-overlay",
        "width": 980,
        "height": 172,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false
      },
      {
        "label": "champion-rank-overlay",
        "title": "海克斯大乱斗小助手 · 英雄排名",
        "create": false,
        "url": "index.html?window=champion-rank-overlay",
        "width": 306,
        "height": 92,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "轻量、本地优先的海克斯大乱斗助手",
    "longDescription": "常驻系统托盘，提供英雄排名与海克斯推荐浮层。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "resources": {
      "../workers/ocr/card-layout.json": "workers/ocr/card-layout.json",
      "../workers/ocr/dist/aram-ocr/": "workers/ocr/dist/aram-ocr/"
    }
  }
}
