{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aram-companion.local/schemas/rank-snapshot.schema.json",
  "title": "ARAM Champion Ranking Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patch", "source", "updated_at", "champions"],
  "properties": {
    "schema_version": { "const": 1 },
    "patch": { "type": "string", "minLength": 1, "maxLength": 24 },
    "source": { "type": "string", "minLength": 1, "maxLength": 200 },
    "updated_at": { "type": "string", "minLength": 1, "maxLength": 80 },
    "champions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["champion_id", "name", "position", "total"],
        "properties": {
          "champion_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "position": { "type": "integer", "minimum": 1, "maximum": 300 },
          "total": { "type": "integer", "minimum": 1, "maximum": 300 },
          "badge_tier": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
